{
  "name": "greencode-circuito-vivo-av3",
  "version": "3.0.0",
  "private": true,
  "description": "Circuito Vivo AV3 — analytics e integrações públicas para logística reversa",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "worker": "node dist/src/workers/analytics-worker.js",
    "worker:dev": "tsx src/workers/analytics-worker.ts",
    "dev:worker": "tsx watch src/workers/analytics-worker.ts",
    "db:up": "docker compose up -d db redis",
    "db:status": "docker compose ps",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.8",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.4",
    "@prisma/client": "6.19.3",
    "@sinclair/typebox": "0.34.52",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "dotenv": "^16.4.7",
    "fastify": "^5.12.8",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
